PORT=5000
# Required in Vercel: paste the Supabase Session pooler URI here.
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Set to false only for a local PostgreSQL server that does not use TLS.
DB_SSL=false
# Keep this at 1 for serverless deployments such as Vercel.
DB_POOL_MAX=1

# Optional local PostgreSQL fallback when DATABASE_URL is not set.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
JWT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMAIL_USER=
EMAIL_PASSWORD=
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
